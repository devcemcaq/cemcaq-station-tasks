# Copia este archivo a `.env` en la PC de la estación y llena los valores.
# `.env` no se versiona: aquí van credenciales.

# Clave generada en el panel (Telemetría › Canales › Claves) para ESTA estación.
STATION_KEY=

# Backend del panel de control (sin diagonal final).
DASHBOARD_API_URL=https://<backend-en-render>.onrender.com

# SQL Server Express del datalogger Agilaire (los mismos datos que usa libagilaire.py).
AGILAIRE_SERVER=8872_1482\SQLEXPRESS2019
AGILAIRE_DB=AVData
AGILAIRE_USER=
AGILAIRE_PASSWORD=
AGILAIRE_DRIVER=SQL Server

# Horas hacia atrás que se reenvían en cada corrida. El backend upsertea, así
# que reenviar de más sólo rellena huecos; 26 h cubre una noche sin internet.
LOOKBACK_HOURS=26

# Zona horaria fija del datalogger (Querétaro: UTC-6 todo el año).
UTC_OFFSET=-06:00
